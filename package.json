{
  "name": "pleniluner-space-station",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack -p 3000",
    "build": "next build --webpack",
    "media:prepare": "node scripts/prepare-artwork.mjs",
    "test": "npm run test:i18n && npm run build && npm run test:export",
    "test:export": "node --test tests/export.test.mjs",
    "lint": "eslint src scripts tests next.config.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test:i18n": "node --test tests/i18n.test.mjs tests/profile.test.mjs",
    "predev": "npm run media:prepare",
    "prebuild": "npm run media:prepare",
    "docs:build": "node scripts/build-docs.mjs"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "sharp": "0.34.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "author": "Pleniluner",
  "contributors": [
    "Pleniluner"
  ]
}
